&uart0 {
	status = "okay";
	current-speed = <115200>;
	tx-pin = <29>;
	rx-pin = <36>;
	rts-pin = <13>;
	cts-pin = <16>;
};
&uart1 {
	status = "okay";
	current-speed = <1000000>;
	tx-pin = <40>;
	rx-pin = <38>;
	rts-pin = <19>;
	cts-pin = <21>;
};

&zephyr_udc0 {
	cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_0";
	};

	cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_1";
	};
};
